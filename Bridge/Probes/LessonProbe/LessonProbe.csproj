<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of the TestRange drills without Unreal: arms each drill, starts the match and the lesson through
       the function tables exactly as Unreal calls them, plays it with the lesson's own actions (walk off the tower,
       switch vision at touchdown; walk up behind the mercenary and grab) and asserts the coach measured it (exit 1 on
       any failure). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>
