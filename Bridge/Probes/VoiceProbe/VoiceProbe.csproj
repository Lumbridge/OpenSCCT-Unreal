<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of the voice bridge without Unreal: the microphone test against the bridge's own relay, then a
       real dedicated OpenSCCT server on localhost with two players in its lobby, a 440 Hz tone each way, read through
       the voice table as Unreal reads it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>
