<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of the practice grab-area table without Unreal: hosts a practice match with bots through the
       function tables exactly as Unreal calls them and asserts the mercenaries' grab windows come back, then hosts
       a normal match and asserts the table refuses (exit 1 on any failure). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>
