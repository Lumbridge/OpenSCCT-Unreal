<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of the online bridge without Unreal: starts a real dedicated OpenSCCT server on localhost,
       joins it through OnlineBridge, plays a round with the server's bots and prints what Unreal would read. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>
