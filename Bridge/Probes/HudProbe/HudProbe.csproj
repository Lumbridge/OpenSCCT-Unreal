<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of the HUD bridge without Unreal: hosts a map with bots, plays the local player for a few
       seconds and prints what Unreal's HUD would read (state, round, lists, scoreboard and the drained messages). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>
