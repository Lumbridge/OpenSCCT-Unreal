<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of the events feature without Unreal: hosts a map with bots, fires the local player's gun and
       prints the events, resolved sounds, shots, effect actors, impact marks and ambient sounds Unreal would read. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>
