<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of the Enhanced SCCT Versus import and the Help & feedback report without Unreal: writes a small
       Reloaded install (its config, a profile, two key files and the shortcut to them) and prints what the import maps
       it onto, then the report details and the bug report address. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>
