<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of the hub bridge without Unreal: hosts a real hub server in-process on localhost, joins it
       through the HubExports table and prints the state transitions Unreal would follow. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>
