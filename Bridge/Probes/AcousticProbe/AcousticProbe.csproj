<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of sound through walls without Unreal: hosts a map, finds a source behind a wall next to an
       opening and one seen through that opening, and prints what the acoustic table gives each (occlusion, low-pass,
       the place it is heard from and the way it takes). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>
