<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of the saved gear without Unreal: a loadout of non-default gadgets saved and read back through
       the exported table, a local match whose spawned pawn must carry it, a gear change asked for mid-round and the
       server's answer, and the profile choices the simulation reads. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>
