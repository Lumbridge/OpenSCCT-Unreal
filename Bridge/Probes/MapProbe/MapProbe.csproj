<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of the strategic map's table without Unreal: a lobby's map overview (floors, pictures,
       legend, places, Up and Down), then a local round with the live markers of the player and his team mates. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>
