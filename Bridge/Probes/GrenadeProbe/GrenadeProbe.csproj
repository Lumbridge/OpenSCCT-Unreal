<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of the merc's launched grenades without Unreal: hosts a map as a merc under the practice
       rules, throws frags with a tap, a short hold and a full charge through the input mapper (as Unreal sends the
       devices) and through the buttons alone (as a client with no mapper), and prints the fuse and the flight. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>
