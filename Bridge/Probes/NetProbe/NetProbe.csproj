<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of the netcode checks' bridge half without Unreal: arms a simulated link through the test table
       (TestExports.SetNextMatchLink) as the client's play-net tests do, starts the match through the main table, runs
       it for a while and prints the measured round trip, corrections, resets, link counters and each pawn's drift;
       for the grab and co-op scenarios it waits for the scenario to finish. Exit 1 on a failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>
