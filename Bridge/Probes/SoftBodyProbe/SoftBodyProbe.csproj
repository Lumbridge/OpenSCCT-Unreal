<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of the map's soft bodies without Unreal: hosts a map, builds the bodies from its render data, walks a pawn-sized cylinder through one and shoots one, and prints how far they move and which sounds were played. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>

