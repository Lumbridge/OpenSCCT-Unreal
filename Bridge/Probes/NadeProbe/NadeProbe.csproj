<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of the grenade preview without Unreal: hosts a map, throws real grenades as a merc and as a
       spy at several aims and charge values, and compares each real flight, tick by tick and where it ends, with
       the path the preview predicted the moment before the throw. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>
