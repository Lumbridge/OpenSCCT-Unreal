<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of the local player's laser while the view turns, without Unreal: hosts a map as a merc and
       as a spy, turns the mouse at 240 frames a second and compares the beam the simulation places once a tick with
       the beam the bridge hands Unreal for each frame. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>
