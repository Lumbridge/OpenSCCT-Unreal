<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console check of the menu's live backdrop without Unreal: makes a bots-only match ready on a worker, watches
       it as the spectating local player for a few seconds, then makes a second map's match ready while the first
       still ticks and prints the longest update of the first in that time. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenScct.UnrealBridge\OpenScct.UnrealBridge.csproj" />
  </ItemGroup>
</Project>
